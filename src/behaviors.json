{
  "behaviorSchemaVersion": "integration.behaviors.v2",
  "devices": [
    {
      "id": "i2c_environmental_sensor",
      "name": "I2C Environmental Sensor",
      "description": "Environmental and particulate sensors connected through a local I2C adapter.",
      "deviceClass": "environmental_sensor",
      "entityType": "sensor",
      "capabilities": [
        "connected",
        "temperature_c",
        "humidity_percent",
        "pressure_hpa",
        "gas_ohms",
        "pm1_0_standard_ugm3",
        "pm2_5_standard_ugm3",
        "pm10_standard_ugm3",
        "pm1_0_env_ugm3",
        "pm2_5_env_ugm3",
        "pm10_env_ugm3",
        "refresh"
      ],
      "intents": [
        {
          "id": "monitor_environment",
          "label": "Monitor the environment",
          "description": "React to temperature, humidity, pressure, gas resistance, and particulate changes."
        }
      ],
      "triggers": [
        {
          "id": "state_changed",
          "label": "Sensor reading changes",
          "description": "Start when Core records changed I2C sensor capabilities.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "device.state_changed",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 180,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "when"
          }
        }
      ],
      "conditions": [
        {
          "id": "connected",
          "label": "Sensor is connected",
          "type": "boolean",
          "capability": "sensor.connected",
          "operators": [
            "eq",
            "neq"
          ],
          "runtime": {
            "source": "state",
            "field": "connected",
            "operator": "eq"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "temperature_threshold",
          "label": "Temperature threshold",
          "type": "number",
          "capability": "sensor.temperature_c",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "temperature_c",
            "operator": ">"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "humidity_threshold",
          "label": "Humidity threshold",
          "type": "number",
          "capability": "sensor.humidity_percent",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "humidity_percent",
            "operator": ">"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "pressure_threshold",
          "label": "Pressure threshold",
          "type": "number",
          "capability": "sensor.pressure_hpa",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "pressure_hpa",
            "operator": ">"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "gas_resistance_threshold",
          "label": "Gas resistance threshold",
          "type": "number",
          "capability": "sensor.gas_ohms",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "gas_ohms",
            "operator": "<"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "pm25_threshold",
          "label": "PM2.5 threshold",
          "type": "number",
          "capability": "sensor.pm25_ugm3",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "pm2_5_env_ugm3",
            "operator": ">"
          },
          "ui": {
            "group": "only_if"
          }
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Refresh sensor now",
          "description": "Read the selected I2C sensor immediately.",
          "capability": "device.refresh",
          "runtime": {
            "command": "refresh"
          },
          "failure": {
            "strategy": "retry_then_continue",
            "retry": {
              "maxAttempts": 1,
              "delaySeconds": 1,
              "backoff": "fixed"
            },
            "timeoutSeconds": 10,
            "idempotent": true
          },
          "safety": {
            "riskLevel": "low"
          },
          "ui": {
            "group": "do_this"
          }
        }
      ],
      "freshness": {
        "maxAgeSeconds": 180,
        "staleDataMode": "block"
      },
      "ui": {
        "icon": "thermometer",
        "category": "environmental_sensor"
      }
    }
  ],
  "templates": [
    {
      "id": "i2c_pm25_guard",
      "label": "Recheck elevated I2C PM2.5",
      "description": "Refresh the selected I2C sensor when PM2.5 exceeds 35 µg/m³, with a 15-minute cooldown.",
      "category": "Air quality",
      "deviceKey": "i2c_environmental_sensor",
      "config": {
        "automation_schema_version": "automation.behavior.v2",
        "triggers": [
          {
            "id": "state_changed",
            "label": "I2C reading changes",
            "type": "integration_event",
            "event": "device.state_changed",
            "capability": "telemetry.state",
            "enabled": true,
            "sourceRef": {
              "integrationId": "{{integrationId}}",
              "integrationKey": "{{integrationKey}}",
              "configId": "{{configId}}",
              "behaviorDeviceKey": "i2c_environmental_sensor",
              "optionKey": "state_changed",
              "capability": "telemetry.state"
            }
          }
        ],
        "trigger": {
          "id": "state_changed",
          "label": "I2C reading changes",
          "type": "integration_event",
          "event": "device.state_changed",
          "capability": "telemetry.state",
          "enabled": true
        },
        "intent": "air_quality_monitoring",
        "conditionTree": {
          "id": "i2c_pm25_guard_condition",
          "label": "PM2.5 is above 35 µg/m³",
          "field": "pm2_5_env_ugm3",
          "operator": ">",
          "value": 35,
          "sourceRef": {
            "integrationId": "{{integrationId}}",
            "integrationKey": "{{integrationKey}}",
            "configId": "{{configId}}",
            "behaviorDeviceKey": "i2c_environmental_sensor",
            "optionKey": "pm25_threshold",
            "capability": "sensor.pm25_ugm3"
          }
        },
        "actions": [
          {
            "id": "i2c_pm25_guard_action",
            "label": "Refresh I2C sensor",
            "action": "refresh",
            "capability": "device.refresh",
            "sourceRef": {
              "integrationId": "{{integrationId}}",
              "integrationKey": "{{integrationKey}}",
              "configId": "{{configId}}",
              "behaviorDeviceKey": "i2c_environmental_sensor",
              "optionKey": "refresh",
              "capability": "device.refresh"
            },
            "target": {
              "mode": "selection",
              "configIds": [
                "{{configId}}"
              ]
            }
          }
        ],
        "safety": {
          "staleDataMode": "block",
          "maxAgeSeconds": 300,
          "requireFreshTrigger": true,
          "dryRunFirst": true
        },
        "failure": {
          "strategy": "follow_edges",
          "fallbackBehaviorId": "",
          "conditionTree": {
            "op": "and",
            "children": []
          }
        },
        "stop": {
          "never": true
        },
        "override": {
          "mode": "continue"
        },
        "execution": {
          "failureStrategy": "follow_edges",
          "fallbackBehaviorId": "",
          "dispatchMode": "runtime"
        },
        "policies": {
          "execution": {
            "failureStrategy": "follow_edges",
            "fallbackBehaviorId": "",
            "dispatchMode": "runtime"
          },
          "freshness": {
            "staleDataMode": "block"
          },
          "manualOverride": {
            "mode": "continue"
          },
          "cooldownSeconds": 900
        }
      },
      "metadata": {
        "recommended": true,
        "requiresReview": true
      }
    }
  ],
  "telemetry": {
    "capabilityMappings": [
      {
        "nativeMetric": "connected",
        "capability": "sensor.connected"
      },
      {
        "nativeMetric": "temperature_c",
        "capability": "sensor.temperature_c"
      },
      {
        "nativeMetric": "humidity_percent",
        "capability": "sensor.humidity_percent"
      },
      {
        "nativeMetric": "pressure_hpa",
        "capability": "sensor.pressure_hpa"
      },
      {
        "nativeMetric": "gas_ohms",
        "capability": "sensor.gas_ohms"
      },
      {
        "nativeMetric": "pm1_0_standard_ugm3",
        "capability": "sensor.pm1_standard_ugm3"
      },
      {
        "nativeMetric": "pm2_5_standard_ugm3",
        "capability": "sensor.pm25_standard_ugm3"
      },
      {
        "nativeMetric": "pm10_standard_ugm3",
        "capability": "sensor.pm10_standard_ugm3"
      },
      {
        "nativeMetric": "pm1_0_env_ugm3",
        "capability": "sensor.pm1_ugm3"
      },
      {
        "nativeMetric": "pm2_5_env_ugm3",
        "capability": "sensor.pm25_ugm3"
      },
      {
        "nativeMetric": "pm10_env_ugm3",
        "capability": "sensor.pm10_ugm3"
      },
      {
        "nativeMetric": "particles_0_3um_per_0_1l",
        "capability": "sensor.particles_03um"
      },
      {
        "nativeMetric": "particles_0_5um_per_0_1l",
        "capability": "sensor.particles_05um"
      },
      {
        "nativeMetric": "particles_1_0um_per_0_1l",
        "capability": "sensor.particles_10um"
      },
      {
        "nativeMetric": "particles_2_5um_per_0_1l",
        "capability": "sensor.particles_25um"
      },
      {
        "nativeMetric": "particles_5_0um_per_0_1l",
        "capability": "sensor.particles_50um"
      },
      {
        "nativeMetric": "particles_10um_per_0_1l",
        "capability": "sensor.particles_100um"
      }
    ]
  }
}
